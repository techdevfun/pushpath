{"author":"TECHDEV","bin":{"pushpath":"./dist/cli.js"},"description":"A zero-dependency CLI that traces the deploy path in a GitHub repo and answers one question from local evidence: can a single compromised account walk alone from push to production?","devDependencies":{"@eslint/js":"^10.0.1","@types/node":"^22.20.5","eslint":"^10.15.0","globals":"^16.5.0","prettier":"^3.10.1","typescript":"^5.9.3","typescript-eslint":"^8.72.2"},"engines":{"node":">=20"},"keywords":["cli","github-actions","deploy","supply-chain","security","audit","ci-gate","pushpath"],"license":"MIT","name":"pushpath","repository":{"type":"git","url":"https://github.com/techdevfun/pushpath.git"},"scripts":{"build":"tsc","format":"prettier --write \"src/**/*.ts\" \"test/**/*.js\" \"scripts/**/*.js\" \"eslint.config.js\"","lint":"eslint . && prettier --check \"src/**/*.ts\" \"test/**/*.js\" \"scripts/**/*.js\" \"eslint.config.js\"","preflight":"node scripts/preflight.js","test":"npm run build && node --test test/unit.test.js test/e2e.test.js","test:live":"node --test test/live.test.js"},"type":"module","version":"0.1.0"}